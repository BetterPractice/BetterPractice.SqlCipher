<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.1.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BetterPractice.SqlCipher.Core\BetterPractice.SqlCipher.Core.csproj" />
    <!-- Generator must also run on this project to emit mappers for entities defined here -->
    <ProjectReference Include="..\..\src\BetterPractice.SqlCipher.Generator\BetterPractice.SqlCipher.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Copy the native library for the current RID into the test output directory -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Content Include="..\..\native\bin\osx-arm64\libsqlcipher.dylib"
             Condition="('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'osx-arm64') And Exists('..\..\native\bin\osx-arm64\libsqlcipher.dylib')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\native\bin\osx-x64\libsqlcipher.dylib"
             Condition="'$(RuntimeIdentifier)' == 'osx-x64' And Exists('..\..\native\bin\osx-x64\libsqlcipher.dylib')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <Content Include="..\..\native\bin\linux-x64\libsqlcipher.so"
             Condition="('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'linux-x64') And Exists('..\..\native\bin\linux-x64\libsqlcipher.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\native\bin\linux-arm64\libsqlcipher.so"
             Condition="'$(RuntimeIdentifier)' == 'linux-arm64' And Exists('..\..\native\bin\linux-arm64\libsqlcipher.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Content Include="..\..\native\bin\win-x64\sqlcipher.dll"
             Condition="('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'win-x64') And Exists('..\..\native\bin\win-x64\sqlcipher.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\native\bin\win-arm64\sqlcipher.dll"
             Condition="'$(RuntimeIdentifier)' == 'win-arm64' And Exists('..\..\native\bin\win-arm64\sqlcipher.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
